<Page x:Class="WpfApp1.Pages.AddUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Пользователь">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Width="500" VerticalAlignment="Center" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Логин" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="TextBoxLogin" Grid.Row="0" Grid.Column="1" MaxLength="30"
                     ToolTip="3-30 символов, только английские буквы и цифры"/>

            <TextBlock x:Name="TextBlockPassword" Grid.Row="1" Text="Пароль" VerticalAlignment="Center" Margin="5"/>
            <PasswordBox x:Name="PasswordBoxUser" Grid.Row="1" Grid.Column="1"
                         ToolTip="От 6 символов, английская раскладка, минимум одна цифра"/>

            <TextBlock Grid.Row="2" Text="Роль" VerticalAlignment="Center" Margin="5"/>
            <ComboBox x:Name="ComboBoxRole" Grid.Row="2" Grid.Column="1" SelectedIndex="0" ToolTip="Выберите роль">
                <ComboBoxItem Content="User"/>
                <ComboBoxItem Content="Admin"/>
            </ComboBox>

            <TextBlock Grid.Row="3" Text="ФИО" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="TextBoxFio" Grid.Row="3" Grid.Column="1" MaxLength="100"
                     ToolTip="Только буквы, пробелы и дефис" PreviewTextInput="Fio_PreviewTextInput"/>

            <TextBlock Grid.Row="4" Text="Фото (необязательно)" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="TextBoxPhoto" Grid.Row="4" Grid.Column="1" MaxLength="200"
                     ToolTip="Путь к файлу фотографии, например res/user.png"/>

            <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="Сохранить" ToolTip="Сохранить данные" Click="ButtonSave_Click"/>
                <Button Content="Очистить" ToolTip="Очистить все поля" Click="ButtonClean_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
