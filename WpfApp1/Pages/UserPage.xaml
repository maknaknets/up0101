<Page x:Class="WpfApp1.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мои перевозки">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" HorizontalAlignment="Center" Margin="5">
            <Grid Width="230">
                <TextBox x:Name="TextBoxSearch" ToolTip="Введите название груза для поиска"
                         Tag="{Binding ElementName=HintSearch}" TextChanged="Filter_Changed"/>
                <TextBlock x:Name="HintSearch" Text="Поиск по названию груза" Style="{DynamicResource Hint}"/>
            </Grid>
            <ComboBox x:Name="ComboBoxSort" Width="230" SelectedIndex="0" ToolTip="Сортировка"
                      SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Дата: сначала новые"/>
                <ComboBoxItem Content="Дата: сначала старые"/>
                <ComboBoxItem Content="Стоимость: по возрастанию"/>
                <ComboBoxItem Content="Стоимость: по убыванию"/>
            </ComboBox>
            <ComboBox x:Name="ComboBoxType" Width="200" ToolTip="Фильтр по типу груза"
                      SelectionChanged="Filter_Changed"/>
            <Button Content="Сбросить фильтры" ToolTip="Сбросить поиск, сортировку и фильтр" Click="ButtonReset_Click"/>
        </WrapPanel>

        <DataGrid x:Name="DataGridShipments" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding ShipDate, StringFormat=dd.MM.yyyy}"/>
                <DataGridTextColumn Header="Название груза" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Тип груза" Binding="{Binding CargoType.Name}"/>
                <DataGridTextColumn Header="Вес, кг" Binding="{Binding Weight}"/>
                <DataGridTextColumn Header="Стоимость, руб." Binding="{Binding Price}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
