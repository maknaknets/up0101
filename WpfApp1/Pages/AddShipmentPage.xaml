<Page x:Class="WpfApp1.Pages.AddShipmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Перевозка">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Width="540" VerticalAlignment="Center" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Название груза" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="TextBoxName" Grid.Row="0" Grid.Column="1" MaxLength="100"
                     ToolTip="Например: Цемент М500"/>

            <TextBlock Grid.Row="1" Text="Тип груза" VerticalAlignment="Center" Margin="5"/>
            <ComboBox x:Name="ComboBoxType" Grid.Row="1" Grid.Column="1" ToolTip="Выберите тип груза"
                      DisplayMemberPath="Name" SelectedValuePath="ID"/>

            <TextBlock Grid.Row="2" Text="Клиент" VerticalAlignment="Center" Margin="5"/>
            <ComboBox x:Name="ComboBoxUser" Grid.Row="2" Grid.Column="1" ToolTip="Выберите клиента"
                      DisplayMemberPath="FIO" SelectedValuePath="ID"/>

            <TextBlock Grid.Row="3" Text="Дата перевозки" VerticalAlignment="Center" Margin="5"/>
            <DatePicker x:Name="DatePickerShip" Grid.Row="3" Grid.Column="1" ToolTip="Выберите дату перевозки"
                        DisplayDateStart="2020-01-01"/>

            <TextBlock Grid.Row="4" Text="Вес, кг (от 1 до 40000)" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="TextBoxWeight" Grid.Row="4" Grid.Column="1" MaxLength="5"
                     ToolTip="Только цифры, от 1 до 40000" PreviewTextInput="Digits_PreviewTextInput"/>

            <TextBlock Grid.Row="5" Text="Стоимость, руб. (от 100 до 10 000 000)" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="TextBoxPrice" Grid.Row="5" Grid.Column="1" MaxLength="8"
                     ToolTip="Только цифры, от 100 до 10000000" PreviewTextInput="Digits_PreviewTextInput"/>

            <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="Сохранить" ToolTip="Сохранить данные" Click="ButtonSave_Click"/>
                <Button Content="Очистить" ToolTip="Очистить все поля" Click="ButtonClean_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
