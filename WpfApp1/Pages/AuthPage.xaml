<Page x:Class="WpfApp1.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизация">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Width="300" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10">
            <Image Source="/res/logo.png" Height="110" Margin="0,0,0,10"/>
            <TextBlock Text="Вход в систему" HorizontalAlignment="Center" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

            <Grid>
                <TextBox x:Name="TextBoxLogin" MaxLength="30" ToolTip="Введите логин"
                         Tag="{Binding ElementName=HintLogin}" TextChanged="Field_Changed"/>
                <TextBlock x:Name="HintLogin" Text="Логин" Style="{DynamicResource Hint}"/>
            </Grid>
            <Grid>
                <PasswordBox x:Name="PasswordBoxLogin" ToolTip="Введите пароль"
                             Tag="{Binding ElementName=HintPassword}" PasswordChanged="Field_Changed"/>
                <TextBlock x:Name="HintPassword" Text="Пароль" Style="{DynamicResource Hint}"/>
            </Grid>

            <StackPanel x:Name="CaptchaPanel" Visibility="Collapsed">
                <TextBlock x:Name="TextBlockCaptcha" HorizontalAlignment="Center" FontSize="26" FontStyle="Italic"
                           FontWeight="Bold" TextDecorations="Strikethrough" Margin="0,5"
                           Foreground="{DynamicResource ErrorBrush}"
                           ToolTip="Введите эти символы вручную (копирование невозможно)"/>
                <Grid>
                    <TextBox x:Name="TextBoxCaptcha" MaxLength="5" ToolTip="Введите символы с капчи"
                             Tag="{Binding ElementName=HintCaptcha}" TextChanged="Field_Changed"/>
                    <TextBlock x:Name="HintCaptcha" Text="Введите капчу" Style="{DynamicResource Hint}"/>
                </Grid>
            </StackPanel>

            <Button Content="Вход" ToolTip="Войти в систему" Click="ButtonEnter_Click"/>
            <Button Content="Регистрация" ToolTip="Создать нового пользователя" Click="ButtonReg_Click"/>
            <Button Content="Смена пароля" ToolTip="Изменить пароль учётной записи" Click="ButtonChangePassword_Click"/>
        </StackPanel>
    </ScrollViewer>
</Page>
