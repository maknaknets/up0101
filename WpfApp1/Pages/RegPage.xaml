<Page x:Class="WpfApp1.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Width="320" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10">
            <Grid>
                <TextBox x:Name="TextBoxLogin" MaxLength="30"
                         ToolTip="Логин: 3-30 символов, только английские буквы и цифры"
                         Tag="{Binding ElementName=HintLogin}" TextChanged="Field_Changed"/>
                <TextBlock x:Name="HintLogin" Text="Логин" Style="{DynamicResource Hint}"/>
            </Grid>
            <Grid>
                <PasswordBox x:Name="PasswordBox1"
                             ToolTip="Пароль: от 6 символов, английская раскладка, минимум одна цифра"
                             Tag="{Binding ElementName=HintPassword1}" PasswordChanged="Field_Changed"/>
                <TextBlock x:Name="HintPassword1" Text="Пароль" Style="{DynamicResource Hint}"/>
            </Grid>
            <Grid>
                <PasswordBox x:Name="PasswordBox2" ToolTip="Повторите пароль"
                             Tag="{Binding ElementName=HintPassword2}" PasswordChanged="Field_Changed"/>
                <TextBlock x:Name="HintPassword2" Text="Повторите пароль" Style="{DynamicResource Hint}"/>
            </Grid>
            <Grid>
                <TextBox x:Name="TextBoxFio" MaxLength="100" ToolTip="Фамилия Имя Отчество (только буквы)"
                         PreviewTextInput="Fio_PreviewTextInput"
                         Tag="{Binding ElementName=HintFio}" TextChanged="Field_Changed"/>
                <TextBlock x:Name="HintFio" Text="ФИО" Style="{DynamicResource Hint}"/>
            </Grid>
            <TextBlock Text="Роль" Margin="5,5,5,0"/>
            <ComboBox x:Name="ComboBoxRole" SelectedIndex="0" ToolTip="Выберите роль пользователя">
                <ComboBoxItem Content="User"/>
                <ComboBoxItem Content="Admin"/>
            </ComboBox>
            <Button Content="Зарегистрироваться" ToolTip="Создать учётную запись" Margin="5,15,5,5" Click="ButtonReg_Click"/>
        </StackPanel>
    </ScrollViewer>
</Page>
