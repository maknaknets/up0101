<Page x:Class="WpfApp1.Pages.CargoTypeTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Таблица типов грузов">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="DataGridTypes" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Тип груза" Binding="{Binding Name}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Добавить" ToolTip="Добавить тип груза" Click="ButtonAdd_Click"/>
            <Button Content="Редактировать" ToolTip="Редактировать выбранный тип груза" Click="ButtonEdit_Click"/>
            <Button Content="Удалить" ToolTip="Удалить выбранные типы грузов" Click="ButtonDelete_Click"/>
        </StackPanel>
    </Grid>
</Page>
