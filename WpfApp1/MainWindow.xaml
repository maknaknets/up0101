<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Грузоперевозки" Width="1000" Height="650" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Language="ru-RU"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource MainFont}"
        FontSize="14"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource PanelBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="ButtonBack" Grid.Column="0" Content="Назад"
                    ToolTip="Вернуться на предыдущую страницу" Click="ButtonBack_Click"/>
            <Button x:Name="ButtonLogout" Grid.Column="1" Content="Выйти из аккаунта"
                    ToolTip="Выйти из текущей учётной записи" Click="ButtonLogout_Click"/>
            <TextBlock x:Name="TextBlockTitle" Grid.Column="2" Style="{DynamicResource Heading}"
                       HorizontalAlignment="Center" Margin="10,0"/>
            <Button x:Name="ButtonTheme" Grid.Column="3" Content="Сменить тему"
                    ToolTip="Переключить светлую и тёмную тему" Click="ButtonTheme_Click"/>
        </Grid>

        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Navigated="MainFrame_Navigated"/>

        <Grid Grid.Row="2" Background="{DynamicResource PanelBrush}">
            <TextBlock x:Name="DateTimeNow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"/>
        </Grid>
    </Grid>
</Window>
